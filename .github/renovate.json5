{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The repository-level org policy comes from two shared presets in
  // proofhouse/github-actions, both pulled in via extends:
  //
  //   - renovate-config.json5 — the general repo-level rules plus the
  //     Justfile and Vale custom managers shared by every repo.
  //   - renovate-go-config.json5 — the Go-module policy shared by every Go
  //     repo: gomodTidy as a postUpdateOption and the go-deps grouping for
  //     the gomod manager. Both were inline here until the same pair had
  //     been copy-pasted across all three Go repos.
  //
  // extends resolves after platform initialization, with token auth.
  extends: [
    "github>proofhouse/github-actions//.github/renovate-config.json5",
    "github>proofhouse/github-actions//.github/renovate-go-config.json5",
  ],

  // Global-only identity, rate limits, and requireConfig. These previously
  // came from renovate-global-config.json5 via globalExtends, but Renovate
  // resolves globalExtends before host rules are registered, so that preset
  // fetch was always anonymous and intermittently hit GitHub's per-IP rate
  // limit (config-presets-invalid). Inlining the resolved values removes
  // the pre-auth fetch entirely.
  requireConfig: "ignored",
  username: "proofhouse-renovate[bot]",
  gitAuthor: "proofhouse-renovate[bot] <289255489+proofhouse-renovate[bot]@users.noreply.github.com>",
  prConcurrentLimit: 0,
  prHourlyLimit: 0,

  // Single-repo scope, and the only genuinely local setting left here. It
  // is global-only and differs per repo, so it fits in neither preset.
  repositories: ["proofhouse/gomodscan"],
}
